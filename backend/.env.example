# Copie para .env

# API
PORT=3001
FRONTEND_URL=http://localhost:3000

# MongoDB (docker compose)
MONGODB_URI=mongodb://localhost:27017/escoramento

# Autenticacao do admin
JWT_SECRET=troque-por-um-valor-aleatorio
JWT_EXPIRES_IN=1h
ADMIN_EMAIL=admin@escoramento.local
# Gere com: npm run hash-password
ADMIN_PASSWORD_HASH=

# Storage S3 / MinIO (docker compose)
# AWS real: S3_ENDPOINT e S3_PUBLIC_ENDPOINT vazios, S3_FORCE_PATH_STYLE=false
S3_BUCKET=escoramento-docs
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
# host das URLs assinadas
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
# padrao local do MinIO
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Arquivos
SIGNED_URL_TTL_SECONDS=300
MAX_FILE_SIZE_MB=10
# soma de todos os arquivos guardados; vazio = sem cota
STORAGE_QUOTA_MB=

# Atras de balanceador (Lightsail): 1. Vazio local: o X-Forwarded-For e ignorado
TRUST_PROXY_HOPS=
