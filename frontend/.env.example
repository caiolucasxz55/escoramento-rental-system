# Copie para .env.local
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Opcional: limites de upload mostrados e checados no formulario (padrao: 10 por arquivo, sem teto total).
# Em producao com o backend no Lambda: 4 e 4.
NEXT_PUBLIC_MAX_FILE_SIZE_MB=
NEXT_PUBLIC_MAX_TOTAL_UPLOAD_MB=

# Opcional (avaliacao/demo): mostra o acesso na tela de login.
# Deixe vazio em producao. A senha tem de ser a usada no npm run hash-password.
NEXT_PUBLIC_DEMO_ADMIN_EMAIL=admin@escoramento.local
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=admin123
